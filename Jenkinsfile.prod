// Pipeline 3 de 3: Deploy Prod. Disparado pelo job de UAT depois da validação manual.
// Obtém o artefacto arquivado pelo job de CI e instala-o em Produção.
pipeline {
    agent any

    parameters {
        string(name: 'CI_BUILD', defaultValue: '', description: 'Número do build do job de CI a instalar em Produção')
    }

    stages {
        stage('Deploy Prod') {
            steps {
                script {
                    if (!(params.CI_BUILD ==~ /[0-9]+/)) {
                        error('Indicar um CI_BUILD numérico.')
                    }
                }
                copyArtifacts projectName: 'GitHub-ODSOFT-Dev',
                              selector: specific(params.CI_BUILD),
                              filter: 'artifact/*',
                              fingerprintArtifacts: true
                script { load('deploy/deploy.groovy').run('prod') }
            }
        }
    }
}
